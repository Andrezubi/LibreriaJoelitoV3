@page
@model FrontendLibreria.Pages.Reportes.IndexModel
@{
    ViewData["Title"] = "Gestión de Reportes";
}

<div class="container mt-4">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0"><i class="fas fa-file-alt me-2"></i> @ViewData["Title"]</h2>
        </div>
        <div class="card-body">
            <div class="row text-center">
                <div class="col-md-4 mb-3">
                    <form method="post" asp-page-handler="GenerarVentasProducto">
                        <button type="submit" class="btn btn-outline-primary btn-lg w-100 py-4">
                            <i class="fas fa-box-open mb-3 d-block fa-2x"></i>
                            Ventas por Producto
                        </button>
                    </form>
                </div>
                <div class="col-md-4 mb-3">
                    <form method="post" asp-page-handler="GenerarResumenRecaudacion">
                        <button type="submit" class="btn btn-outline-success btn-lg w-100 py-4">
                            <i class="fas fa-chart-line mb-3 d-block fa-2x"></i>
                            Resumen Recaudación (Sumariado)
                        </button>
                    </form>
                </div>
                <div class="col-md-4 mb-3">
                    <button type="button" class="btn btn-outline-info btn-lg w-100 py-4" data-bs-toggle="modal" data-bs-target="#modalVerComprobante">
                        <i class="fas fa-receipt mb-3 d-block fa-2x"></i>
                        Ver Comprobante
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">Historial / Bitácora de Reportes</h4>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha</th>
                            <th>Acción</th>
                            <th>Usuario</th>
                            <th>Descripción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Bitacora != null && Model.Bitacora.Any())
                        {
                            foreach (var item in Model.Bitacora)
                            {
                                <tr>
                                    <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td><span class="badge bg-secondary">@item.Accion</span></td>
                                    <td>@item.IdUsuario</td>
                                    <td>@item.Descripcion @item.Tabla</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">No hay registros en la bitácora</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Ver Comprobante -->
<div class="modal fade" id="modalVerComprobante" tabindex="-1" aria-labelledby="modalVerComprobanteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="modalVerComprobanteLabel"><i class="fas fa-search me-2"></i>Buscar Comprobante de Venta</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div id="comprobanteError" class="alert alert-danger d-none" role="alert">
                    Por favor ingrese un ID de venta válido.
                </div>
                <div class="mb-3">
                    <label for="idVentaInput" class="form-label fw-bold">ID de Venta:</label>
                    <input type="number" id="idVentaInput" class="form-control form-control-lg" placeholder="Ej: 1001" min="1">
                    <div class="form-text">Ingrese el identificador completo de la venta para visualizar su comprobante.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" onclick="verComprobante()" class="btn btn-info text-white">Buscar y Ver Comprobante</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalEl = document.getElementById('modalVerComprobante');
        modalEl.addEventListener('hidden.bs.modal', function () {
            document.getElementById('idVentaInput').value = '';
            document.getElementById('comprobanteError').classList.add('d-none');
        });

        function verComprobante() {
            const idVenta = document.getElementById('idVentaInput').value;
            const errorDiv = document.getElementById('comprobanteError');

            if (!idVenta || idVenta <= 0) {
                errorDiv.classList.remove('d-none');
                return;
            }
            
            errorDiv.classList.add('d-none');
            // Abrir comprobante
            window.open(`/Reportes?handler=VerComprobante&idVenta=${idVenta}`, '_blank');
            
            // Cerrar el modal
            const modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) {
                modalInstance.hide();
            }
        }
    </script>
}
