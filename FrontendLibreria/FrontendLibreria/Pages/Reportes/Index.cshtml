@page
@model FrontendLibreria.Pages.Reportes.IndexModel
@{
    ViewData["Title"] = "Gestión de Reportes";
}

<div class="container mt-4">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0"><i class="fas fa-file-alt me-2"></i> @ViewData["Title"]</h2>
        </div>

        <div class="card-body">
            <div class="row text-center">
                <div class="col-md-6 mb-3">
                    <form method="post" asp-page-handler="GenerarVentasProducto">
                        <button type="submit" class="btn btn-outline-primary btn-lg w-100 py-4">
                            <i class="fas fa-box-open mb-3 d-block fa-2x"></i>
                            Ventas por Producto
                        </button>
                    </form>
                </div>

                <div class="col-md-6 mb-3">
                    <form method="post" asp-page-handler="GenerarResumenRecaudacion">
                        <button type="submit" class="btn btn-outline-success btn-lg w-100 py-4">
                            <i class="fas fa-chart-line mb-3 d-block fa-2x"></i>
                            Resumen Recaudación (Sumariado)
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
