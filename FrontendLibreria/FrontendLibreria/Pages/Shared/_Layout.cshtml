<!DOCTYPE html>
<html lang="es">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta charset="utf-8" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- GOOGLE FONTS -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/globals.css" />
    <link rel="stylesheet" href="~/css/style.css" />

    <title>@ViewData["Title"]</title>
</head>

@{
                //var enSistema = User.Identity != null && User.Identity.IsAuthenticated;
                var esAdministrador = User.IsInRole("Administrador");
                var esEmpleado = User.IsInRole("Empleado");
                var enSistema = esAdministrador || esEmpleado;
                var ocultarSidebar = ViewData["OcultarSidebar"] != null && (bool)ViewData["OcultarSidebar"];
                var debeCambiarPassword = User.FindFirst("MustChangePassword")?.Value == "true";
}

<body class="@(enSistema && !ocultarSidebar ? "bg-sistema" : "")">

    <header class="main-header">

        <div class="header-left">
            <div class="logo"></div>

            <div class="header-text">
                <div class="titulo-sistema">
                    LIBRERÍA JOELITO
                </div>
                <div class="subtitulo-sistema">
                    Sistema de Gestión de Librería
                </div>
            </div>
        </div>

        <div class="header-right">

            @if (enSistema)
            {
                <div class="user-info">
                    <span class="user-name">
                        @User.Identity?.Name
                    </span>

                    @if (!debeCambiarPassword)
                    {
                        <button type="button"
                                class="btn-password"
                                data-bs-toggle="modal"
                                data-bs-target="#cambiarPasswordModal">
                            Cambiar contrase&ntilde;a
                        </button>
                    }

                    <form method="get" action="/Usuarios/Logout">
                        <button type="submit" class="btn-logout">Cerrar sesión</button>
                    </form>
                </div>
            }

            @if (IsSectionDefined("HeaderButtons"))
            {
                <div style="display:@(enSistema ? "none" : "flex")">
                    @RenderSection("HeaderButtons")
                </div>
            }

        </div>
    </header>

    @if (enSistema && !ocultarSidebar)
    {
        @if (debeCambiarPassword)
        {
            <div class="alert alert-danger m-0 text-center rounded-0" style="z-index: 1000; position: relative;">
                <strong>¡Acceso Restringido!</strong> Por razones de seguridad, debes cambiar tu contraseña obligatoriamente para poder acceder al sistema.
            </div>
            <main class="content-area full-width">
                @RenderBody()
            </main>
        }
        else
        {
        <div class="sistema-de-gestion">

            <div class="main-container">

                <!-- SIDEBAR -->
                <aside class="sidebar">

                    <a href="/Index" class="menu-item active">
                        <img class="menu-icon" src="~/img/home-lib.svg">
                        <span>Inicio</span>
                    </a>

                    @if (esAdministrador || esEmpleado)
                    {
                        <!-- PRODUCTOS -->
                        <div class="menu-item d-flex justify-content-between align-items-center">

                            <a class="menu-link d-flex align-items-center">
                                <img class="menu-icon" src="~/img/prod-lib.svg">
                                <span>Productos</span>
                            </a>

                            <span class="flecha-toggle" data-bs-toggle="collapse" data-bs-target="#menuProductos">
                                ▾
                            </span>
                        </div>

                        <div class="collapse submenu" id="menuProductos">
                            <a href="/Productos/IndiceProductos" class="submenu-item">
                                <img class="menu-icon" src="~/img/prod-lib.svg">
                                <span>Productos Disponibles</span>
                            </a>

                            <a href="/Marcas/VerMarcas" class="submenu-item">
                                <img class="menu-icon" src="~/img/marca-lib.svg">
                                <span>Marcas Disponibles</span>
                            </a>

                            <a href="/Index" class="submenu-item">
                                <img class="menu-icon" src="~/img/categoria-lib.svg">
                                <span>Categoría</span>
                            </a>



                        </div>
                    }

                    @if (esAdministrador || esEmpleado)
                    {
                        <a href="/Clientes/ClientesGet" class="menu-item">
                            <img class="menu-icon" src="~/img/cli-lib.svg">
                            <span>Clientes</span>
                        </a>
                    }

                    @if (esAdministrador)
                    {
                        <a href="/Usuarios/UsuarioIndex" class="menu-item">
                            <img class="menu-icon" src="~/img/emp-lib.svg">
                            <span>Usuarios</span>
                        </a>

                        <!-- REPORTES — fuera del collapse, visible solo para admin -->
                        <a href="/Index" class="menu-item">
                            <img class="menu-icon" src="~/img/ventas-lib.svg">
                            <span>Reporte Categorías</span>
                        </a>

                    }

                    @if (esAdministrador || esEmpleado)
                    {
                            <a href="/Index" class="menu-item">
                            <img class="menu-icon" src="~/img/ventas-lib.svg">
                            <span>Ventas</span>
                        </a>
                    }

                    @if (esAdministrador || esEmpleado)
                    {
                        <a href="/Index" class="menu-item">
                            <img class="menu-icon" src="~/img/config-lib.svg">
                            <span>Configuración</span>
                        </a>
                    }

                </aside>

                <!-- CONTENIDO -->
                <main class="content-area">
                    @RenderBody()
                </main>

            </div>
        </div>
        }
    }
    else
    {

        <main class="content-area full-width">
            @RenderBody()
        </main>
    }

    @if (enSistema && !debeCambiarPassword)
    {
        <div class="modal fade" id="cambiarPasswordModal" tabindex="-1" aria-labelledby="cambiarPasswordModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content password-modal">
                    <div class="modal-header modal-header-morado">
                        <h5 class="modal-title" id="cambiarPasswordModalLabel">Cambiar contrase&ntilde;a</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <form method="post"
                          asp-page="/Usuarios/CambiarPassword"
                          asp-page-handler="Voluntario"
                          id="cambiarPasswordVoluntarioForm">
                        <div class="modal-body">
                            <p class="text-muted small mb-3">
                                El cambio cerrará su sesión y se aplicará en el próximo inicio.
                            </p>
                            <div id="passwordModalError" class="alert alert-danger d-none" role="alert"></div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold" for="passwordActualModal">Contrase&ntilde;a actual</label>
                                <input class="form-control"
                                       type="password"
                                       id="passwordActualModal"
                                       name="Input.PasswordActual"
                                       autocomplete="current-password"
                                       required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold" for="nuevoPasswordModal">Nueva contrase&ntilde;a</label>
                                <input class="form-control"
                                       type="password"
                                       id="nuevoPasswordModal"
                                       name="Input.NuevoPassword"
                                       autocomplete="new-password"
                                       required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold" for="confirmarPasswordModal">Confirmar nueva contrase&ntilde;a</label>
                                <input class="form-control"
                                       type="password"
                                       id="confirmarPasswordModal"
                                       name="Input.ConfirmarPassword"
                                       autocomplete="new-password"
                                       required />
                                <div id="passwordModalMatchError" class="text-danger small mt-1 d-none">
                                    Las contrase&ntilde;as no coinciden.
                                </div>
                            </div>

                            <div class="password-policy-box">
                                <p class="fw-semibold mb-2">La nueva contrase&ntilde;a debe contener:</p>
                                <ul class="list-unstyled small mb-0">
                                    <li id="modal-policy-length" class="text-danger">Mínimo 8 caracteres</li>
                                    <li id="modal-policy-upper" class="text-danger">Al menos 1 mayúscula</li>
                                    <li id="modal-policy-lower" class="text-danger">Al menos 1 minúscula</li>
                                    <li id="modal-policy-number" class="text-danger">Al menos 1 número</li>
                                    <li id="modal-policy-special" class="text-danger">Al menos 1 carácter especial</li>
                                </ul>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-cancelar" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn-sistema-danger" id="passwordModalSubmit" disabled>
                                Actualizar contrase&ntilde;a
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (enSistema && !debeCambiarPassword)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const modal = document.getElementById("cambiarPasswordModal");
                const form = document.getElementById("cambiarPasswordVoluntarioForm");
                if (!modal || !form) return;

                const actual = document.getElementById("passwordActualModal");
                const nueva = document.getElementById("nuevoPasswordModal");
                const confirmar = document.getElementById("confirmarPasswordModal");
                const submit = document.getElementById("passwordModalSubmit");
                const matchError = document.getElementById("passwordModalMatchError");
                const error = document.getElementById("passwordModalError");

                const reglas = {
                    length: valor => valor.length >= 8,
                    upper: valor => /[A-Z]/.test(valor),
                    lower: valor => /[a-z]/.test(valor),
                    number: valor => /[0-9]/.test(valor),
                    special: valor => /[!@@#\$%\^\&*\)\(+=._-]/.test(valor)
                };

                function marcarPolitica(nombre, valida) {
                    const elemento = document.getElementById("modal-policy-" + nombre);
                    elemento.classList.toggle("text-success", valida);
                    elemento.classList.toggle("text-danger", !valida);
                }

                function validarFormulario() {
                    const valor = nueva.value;
                    const resultados = Object.entries(reglas).map(([nombre, regla]) => {
                        const valida = regla(valor);
                        marcarPolitica(nombre, valida);
                        return valida;
                    });
                    const coinciden = valor !== "" && valor === confirmar.value;
                    matchError.classList.toggle("d-none", confirmar.value === "" || coinciden);
                    submit.disabled = !actual.value || resultados.includes(false) || !coinciden;
                }

                function mostrarError(mensaje) {
                    error.textContent = mensaje;
                    error.classList.remove("d-none");
                }

                [actual, nueva, confirmar].forEach(input => input.addEventListener("input", validarFormulario));

                modal.addEventListener("hidden.bs.modal", function () {
                    form.reset();
                    error.classList.add("d-none");
                    error.textContent = "";
                    validarFormulario();
                });

                form.addEventListener("submit", async function (event) {
                    event.preventDefault();
                    error.classList.add("d-none");
                    submit.disabled = true;
                    submit.textContent = "Actualizando...";

                    try {
                        const response = await fetch(form.action, {
                            method: "POST",
                            body: new FormData(form),
                            headers: { "X-Requested-With": "XMLHttpRequest" }
                        });
                        const resultado = await response.json();

                        if (!response.ok || !resultado.exito) {
                            mostrarError(resultado.mensaje || "No fue posible actualizar la contraseña.");
                            validarFormulario();
                            return;
                        }

                        document.querySelector(".password-modal .modal-body").innerHTML =
                            '<div class="alert alert-success mb-0">Contraseña actualizada. Redirigiendo al inicio de sesión...</div>';
                        document.querySelector(".password-modal .modal-footer").classList.add("d-none");
                        window.setTimeout(function () {
                            window.location.href = "/Usuarios/Login";
                        }, 1800);
                    } catch {
                        mostrarError("No fue posible comunicarse con el servicio de usuarios.");
                        validarFormulario();
                    } finally {
                        submit.textContent = "Actualizar contraseña";
                    }
                });

                validarFormulario();
            });
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
