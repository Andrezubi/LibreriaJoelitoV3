@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<img class="element" src="~/img/background-lib.png">

@section HeaderButtons {

    <a href="/Usuarios/Login" class="btn-login">
        Iniciar sesión
    </a>
}
<div class="center-text">

    <p class="texto-bienvenida">

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            @using System.Globalization

            <text>
                Bienvenido al Sistema de Gestión de la Librería Joelito, @CultureInfo.CurrentCulture.TextInfo.ToTitleCase(User.Identity.Name.Replace(".", " "))
            </text>
        }
        else
        {
            <text>
                Bienvenido al Sistema de Gestión de la Librería Joelito
            </text>
        }

    </p>

    <p class="mensaje-inicio">

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <text>Seleccione una opción del menú para comenzar</text>
        }
        else
        {
            <text>Por favor inicie sesión</text>
        }

    </p>

</div>