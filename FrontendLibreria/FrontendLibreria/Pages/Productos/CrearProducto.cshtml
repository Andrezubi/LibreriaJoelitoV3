@page
@Html.AntiForgeryToken()
@model FrontendLibreria.Pages.Productos.CrearProductoModel
@{
    ViewData["Title"] = "Nuevo Producto";
}

<div class="form-container">

    <div class="form-header">
        Nuevo Producto
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <form method="post">
        
        <div class="form-group mb-3">
            <label>Nombre <span class="text-danger">*</span></label>
            <input asp-for="@Model.Nombre" type="text" required class="form-control" placeholder="Ej: Lapiz" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label>Categoría <span class="text-danger">*</span></label>
            <select asp-for="@Model.IdCategoria" class="form-control">
                <option value=0>Elija una categoría</option>
                @foreach (var categoria in Model.Categorias)
                {
                    <option value="@categoria.Id">@categoria.Nombre</option>
                }
            </select>
            <span asp-validation-for="IdCategoria" class="text-danger d-block"></span>
            <button type="button" class="btn btn-sistema-outline btn-sm mt-2" data-bs-toggle="modal" data-bs-target="#modalCategoria">
                + Nueva Categoría
            </button>
        </div>

        <div class="form-group mb-3">
            <label>Marca <span class="text-danger">*</span></label>
            <select asp-for="@Model.IdMarca" class="form-control">
                <option value=0>Elija una marca</option>
                @foreach (var marca in Model.Marcas)
                {
                    <option value="@marca.Id">@marca.Nombre</option>
                }
            </select>
            <span asp-validation-for="IdMarca" class="text-danger d-block"></span>
            @* Botón de nueva marca comentado según tu código original *@
        </div>

        <div class="form-group mb-4">
            <label>Stock Inicial <span class="text-danger">*</span></label>
            <input asp-for="@Model.Stock" type="number" required class="form-control" placeholder="Ej: 20" />
            <span asp-validation-for="Stock" class="text-danger"></span>
        </div>

        <hr class="mb-4" />
        <h5 class="mb-3 text-secondary">Configuración de Venta (Presentación Inicial)</h5>

        <div class="row">
            <div class="col-md-4 form-group mb-3">
                <label>Presentación <span class="text-danger">*</span></label>
                <select asp-for="IdPresentacionSeleccionada" class="form-control" id="selectPresentacion" required>
                    <option value="">Elija una presentación</option>
                    @foreach (var pres in Model.Presentaciones)
                    {
                        <option value="@pres.Id" data-nombre="@pres.Nombre.ToLower()">
                            @pres.Nombre
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-4 form-group mb-3" id="grupoFactor" style="display:none;">
                <label>Unidades por Presentación <span class="text-danger">*</span></label>
                <input asp-for="FactorConversion" type="number" min="1" class="form-control" id="inputFactor" />
                <small class="text-muted">Ej: Si es "Caja", ¿cuántas unidades trae?</small>
            </div>

            <div class="col-md-4 form-group mb-3">
                <label>Precio de Venta (Bs.) <span class="text-danger">*</span></label>
                <input asp-for="PrecioVenta" type="number" step="0.01" min="0.1" class="form-control" placeholder="Ej: 15.50" required />
            </div>
        </div>

        <button type="submit" class="btn btn-sistema" style="margin: 10px 0;">Guardar Producto</button>
        <a asp-page="IndiceProductos" class="btn btn-cancelar" style="margin: 10px 0;">Volver</a>
    </form>
</div>

<div class="modal fade" id="modalCategoria" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header modal-header-morado">
                <h5>Nueva Categoría</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="errorCategoria" class="alert alert-danger" style="display:none;"></div>
                <input type="text" id="nombreCategoria" class="form-control" placeholder="Nombre de la categoría" />
            </div>
            <div class="modal-footer">
                <button class="btn btn-sistema" onclick="crear('categoria')">Guardar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalMarca" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header modal-header-morado">
                <h5>Nueva Marca</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="errorMarca" class="alert alert-danger" style="display:none;"></div>
                <input type="text" id="nombreMarca" class="form-control" placeholder="Nombre de la marca" />
            </div>
            <div class="modal-footer">
                <button class="btn btn-sistema" onclick="crear('marca')">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // --- LÓGICA DE PRESENTACIONES Y FACTOR DE CONVERSIÓN ---
        document.addEventListener("DOMContentLoaded", function () {
            const selectPresentacion = document.getElementById('selectPresentacion');
            const grupoFactor = document.getElementById('grupoFactor');
            const inputFactor = document.getElementById('inputFactor');

            function actualizarVisibilidadFactor() {
                const opcionSeleccionada = selectPresentacion.options[selectPresentacion.selectedIndex];
                const nombrePres = opcionSeleccionada ? opcionSeleccionada.getAttribute('data-nombre') : '';

                // Si no hay nada seleccionado, o seleccionan 'unidad', forzamos a 1 y ocultamos
                if (!nombrePres || nombrePres.includes('unidad')) {
                    grupoFactor.style.display = 'none';
                    inputFactor.value = 1;
                } else {
                    // Si es caja, paquete, docena, etc., mostramos para que configuren
                    grupoFactor.style.display = 'block';
                    if (inputFactor.value == 1) inputFactor.value = ""; // Obligamos a escribir el factor real
                }
            }

            selectPresentacion.addEventListener('change', actualizarVisibilidadFactor);
        
            // Ejecutar al inicio por si el form recarga con errores y ya había algo seleccionado
            actualizarVisibilidadFactor();
        });

        // --- LÓGICA ORIGINAL DE CREACIÓN RÁPIDA (MODALES) ---
        async function crear(tipo) {
            let inputId = tipo === "categoria" ? "nombreCategoria" : "nombreMarca";
            let handler = tipo === "categoria" ? "CrearCategoria" : "CrearMarca";
            let modalId = tipo === "categoria" ? "modalCategoria" : "modalMarca";
            let errorId = tipo === "categoria" ? "errorCategoria" : "errorMarca";

            let nombre = document.getElementById(inputId).value;
            let errorDiv = document.getElementById(errorId);

            // limpiar error anterior
            errorDiv.style.display = "none";
            errorDiv.textContent = "";

            if (!nombre.trim()) {
                errorDiv.textContent = "El nombre es obligatorio";
                errorDiv.style.display = "block";
                return;
            }

            let token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            let response = await fetch(`?handler=${handler}`, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": token
                },
                body: JSON.stringify({ Nombre: nombre })
            });

            let data = await response.json();

            if (!data.ok) {
                errorDiv.textContent = data.mensaje || data.message;
                errorDiv.style.display = "block";
                return;
            }

            // éxito
            location.reload();
        }
    </script>
}