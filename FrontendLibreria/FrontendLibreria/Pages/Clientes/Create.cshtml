@page
@model FrontendLibreria.Pages.Clientes.CrearClienteModel
@{
    ViewData["Title"] = "Nuevo Cliente";
}

<div class="form-container">

    <div class="form-header">
        Nuevo Cliente
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <form method="post">

        <div class="form-group mb-3">
            <label>Razón Social <strong class="text-danger">*</strong></label>
            <input asp-for="RazonSocial" type="text" required class="form-control" placeholder="Ej: Juan Pérez López" />
            <span asp-validation-for="RazonSocial" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-8 form-group mb-3">
                <label>Carnet de Identidad <strong class="text-danger">*</strong></label>
                <input asp-for="Ci" type="text" required class="form-control" placeholder="Ej: 1234567" />
                <span asp-validation-for="Ci" class="text-danger"></span>
            </div> 

            <div class="col-md-4 form-group mb-3">
                <label>Complemento</label>
                <input asp-for="Complemento" type="text" class="form-control" placeholder="Ej: 1A" />
                <span asp-validation-for="Complemento" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group mb-3">
            <label>Correo Electrónico</label>
            <input asp-for="Email" type="email" class="form-control" placeholder="juan@ejemplo.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group mb-4">
            <div class="form-check">
                <input asp-for="ClienteFrecuente" class="form-check-input" type="checkbox" id="checkFrecuente" />
                <label class="form-check-label" for="checkFrecuente">Es Cliente Frecuente</label>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-sistema">Registrar Cliente</button>
            <a asp-page="ClientesGet" class="btn btn-cancelar ms-2">Cancelar y Volver</a>
        </div>

    </form>
</div>