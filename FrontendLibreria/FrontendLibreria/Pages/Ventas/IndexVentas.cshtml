@page
@model FrontendLibreria.Pages.Ventas.IndexVentasModel

@{
    ViewData["Title"] = "Ventas";
}

<div class="container-fluid mt-4 px-4">
    <div class="d-flex justify-content-center">
        <div class="tabla-wrapper w-100">
            <div class="card shadow-sm tabla-card">

                <div class="card-header d-flex justify-content-between align-items-center tabla-header-custom">
                    <h5 class="mb-0">Lista de Ventas</h5>

                    <a asp-page="Registrar" class="btn btn-sistema btn-sm">
                        + Registrar Venta
                    </a>
                </div>

                @if (!string.IsNullOrEmpty(Model.MensajeExito))
                {
                    <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
                        @Model.MensajeExito
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.MensajeError))
                {
                    <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
                        @Model.MensajeError
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="tabla-head-custom">
                                <tr>
                                    <th>CI Cliente</th>
                                    <th>Cliente</th>
                                    <th>Fecha</th>
                                    <th class="text-end">Total</th>
                                    <th>Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (Model.Ventas == null || !Model.Ventas.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            No existen ventas registradas.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var venta in Model.Ventas)
                                    {
                                        string textoEstado = Model.ObtenerTextoEstado(venta.Estado);
                                        string claseEstado = Model.ObtenerClaseEstado(venta.Estado);
                                        bool puedeVerDetalle = Model.PuedeVerDetalle(venta.Estado);
                                        bool puedeAnular = Model.PuedeAnular(venta.Estado);

                                        <tr id="filaVenta_@venta.Id"
                                            data-idventa="@venta.Id"
                                            data-estado="@venta.Estado">
                                            <td>@venta.CiCliente</td>
                                            <td>@venta.RazonSocialCliente</td>
                                            <td>@venta.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="text-end">Bs @venta.Total.ToString("0.00")</td>
                                            <td>
                                                <span id="badgeEstado_@venta.Id" class="badge @claseEstado">
                                                    @textoEstado
                                                </span>
                                            </td>
                                            <td class="text-center" id="accionesVenta_@venta.Id">
                                                @if (puedeVerDetalle)
                                                {
                                                    <button type="button"
                                                            class="btn btn-sm btn-info btn-ver-detalle"
                                                            data-idventa="@venta.Id">
                                                        Ver
                                                    </button>
                                                }

                                                @if (puedeAnular)
                                                {
                                                    <button type="button"
                                                            class="btn btn-sm btn-danger btn-preparar-anulacion"
                                                            data-idventa="@venta.Id">
                                                        Anular
                                                    </button>
                                                }

                                                @if (!puedeVerDetalle && !puedeAnular)
                                                {
                                                    <span class="text-muted small">Sin acciones</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalVerDetalleVenta" tabindex="-1" aria-labelledby="detalleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header modal-header-morado">
                <h5 class="modal-title" id="detalleModalLabel">Detalle de Venta</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div id="detalleVentaContenido">
                    <div class="text-center text-muted py-4">
                        Cargando detalle...
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="btnVerComprobanteDetalle" data-id-venta="" disabled>
                    Ver comprobante
                </button>

                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="modalConfirmarAnulacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger">

            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirmar anulación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body text-center">
                <p class="mb-2">¿Está seguro de anular esta venta?</p>
                <p class="text-muted mb-0">
                    Esta acción no podrá revertirse.
                </p>
            </div>

            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancelar
                </button>

                <form method="post" asp-page-handler="Anular" id="formAnularVenta">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idVenta" id="idVentaAnular" value="" />

                    <button type="submit" class="btn btn-danger">
                        Sí, anular
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="modalProcesandoAnulacion" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger">

            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Procesando anulación</h5>
            </div>

            <div class="modal-body text-center">
                <div id="spinnerProcesandoAnulacion" class="spinner-border text-danger mb-3" role="status">
                    <span class="visually-hidden">Procesando...</span>
                </div>

                <p id="textoProcesandoAnulacion" class="mb-0">
                    Estamos anulando la venta. Espere un momento...
                </p>
            </div>

            <div class="modal-footer justify-content-center" id="footerProcesandoAnulacion" style="display:none;">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cerrar
                </button>

                <a href="/Ventas/IndexVentas" class="btn btn-primary">
                    Actualizar lista
                </a>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="modalResultadoAnulacion" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-success">

            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Venta anulada</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body text-center">
                <p id="textoResultadoAnulacion" class="mb-0">
                    La venta fue anulada correctamente.
                </p>
            </div>

            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            let ventaSeleccionadaParaAnular = null;

            function obtenerTextoEstado(estado) {
                switch (estado) {
                    case 'PENDIENTE':
                        return 'Pendiente';
                    case 'CONFIRMADA':
                        return 'Confirmada';
                    case 'ANULADA':
                        return 'Anulada';
                    case 'ANULACION_PENDIENTE':
                        return 'Anulación en proceso';
                    case 'STOCK_RECHAZADO':
                    case 'FALLIDA':
                        return 'No completada';
                    case 'STOCK_RESERVADO':
                        return 'En proceso';
                    default:
                        return 'En proceso';
                }
            }

            function obtenerClaseEstado(estado) {
                switch (estado) {
                    case 'PENDIENTE':
                    case 'ANULACION_PENDIENTE':
                        return 'bg-warning text-dark';
                    case 'CONFIRMADA':
                        return 'bg-success';
                    case 'ANULADA':
                        return 'bg-secondary';
                    case 'STOCK_RECHAZADO':
                    case 'FALLIDA':
                        return 'bg-danger';
                    case 'STOCK_RESERVADO':
                        return 'bg-info text-dark';
                    default:
                        return 'bg-dark';
                }
            }

            function puedeVerDetalle(estado) {
                return estado === 'CONFIRMADA' || estado === 'ANULADA';
            }

            function puedeAnular(estado) {
                return estado === 'CONFIRMADA';
            }

            function actualizarFilaVenta(idVenta, estado) {
                const fila = document.getElementById(`filaVenta_${idVenta}`);
                const badge = document.getElementById(`badgeEstado_${idVenta}`);
                const acciones = document.getElementById(`accionesVenta_${idVenta}`);

                if (!fila || !badge || !acciones) {
                    return;
                }

                fila.dataset.estado = estado;

                badge.className = `badge ${obtenerClaseEstado(estado)}`;
                badge.textContent = obtenerTextoEstado(estado);

                let htmlAcciones = '';

                if (puedeVerDetalle(estado)) {
                    htmlAcciones += `
                        <button type="button"
                                class="btn btn-sm btn-info btn-ver-detalle"
                                data-idventa="${idVenta}">
                            Ver
                        </button>
                    `;
                }

                if (puedeAnular(estado)) {
                    htmlAcciones += `
                        <button type="button"
                                class="btn btn-sm btn-danger btn-preparar-anulacion"
                                data-idventa="${idVenta}">
                            Anular
                        </button>
                    `;
                }

                if (!puedeVerDetalle(estado) && !puedeAnular(estado)) {
                    htmlAcciones = `<span class="text-muted small">Sin acciones</span>`;
                }

                acciones.innerHTML = htmlAcciones;

                reconectarEventosBotones();
            }

            function reconectarEventosBotones() {
                document.querySelectorAll('.btn-ver-detalle').forEach(btn => {
                    btn.onclick = function () {
                        abrirDetalleVenta(this.dataset.idventa);
                    };
                });

                document.querySelectorAll('.btn-preparar-anulacion').forEach(btn => {
                    btn.onclick = function () {
                        ventaSeleccionadaParaAnular = this.dataset.idventa;
                        document.getElementById('idVentaAnular').value = ventaSeleccionadaParaAnular;

                        const modal = new bootstrap.Modal(document.getElementById('modalConfirmarAnulacion'));
                        modal.show();
                    };
                });
            }

            function abrirDetalleVenta(idVenta) {
                const contenedor = document.getElementById('detalleVentaContenido');
                const btnVerComprobante = document.getElementById('btnVerComprobanteDetalle');

                btnVerComprobante.dataset.idVenta = '';
                btnVerComprobante.disabled = true;

                contenedor.innerHTML = `
                    <div class="text-center text-muted py-4">
                        Cargando detalle...
                    </div>
                `;

                const modal = new bootstrap.Modal(document.getElementById('modalVerDetalleVenta'));
                modal.show();

                fetch(`?handler=ObtenerDetalleVenta&idVenta=${idVenta}`)
                    .then(r => r.json())
                    .then(data => {
                        if (!data.success) {
                            contenedor.innerHTML = `
                                <div class="alert alert-danger">
                                    ${data.message || 'No se pudo obtener el detalle de la venta.'}
                                </div>
                            `;
                            return;
                        }

                        const venta = data.venta;
                        const detalles = data.detalles || [];
                        btnVerComprobante.dataset.idVenta = venta.idVenta;
                        btnVerComprobante.disabled = false;

                        let filas = '';

                        detalles.forEach(detalle => {
                            filas += `
                                <tr>
                                    <td>${detalle.producto}</td>
                                    <td>${detalle.presentacion}</td>
                                    <td class="text-end">${detalle.cantidad}</td>
                                    <td class="text-end">Bs ${Number(detalle.precioUnitario).toFixed(2)}</td>
                                    <td class="text-end">Bs ${Number(detalle.subtotal).toFixed(2)}</td>
                                </tr>
                            `;
                        });

                        contenedor.innerHTML = `
                            <div class="mb-3">
                                <h6 class="fw-bold">Datos de la venta</h6>

                                <div class="row">
                                    <div class="col-md-6">
                                        <p class="mb-1"><strong>Estado:</strong> ${obtenerTextoEstado(venta.estado)}</p>
                                        <p class="mb-1"><strong>Fecha:</strong> ${venta.fecha}</p>
                                    </div>

                                    <div class="col-md-6">
                                        <p class="mb-1"><strong>Cliente:</strong> ${venta.nombreCliente}</p>
                                        <p class="mb-1"><strong>CI:</strong> ${venta.ciCliente}</p>
                                        <p class="mb-1"><strong>Email:</strong> ${venta.emailCliente || '-'}</p>
                                    </div>
                                </div>

                                <p class="mb-1"><strong>Total:</strong> Bs ${Number(venta.total).toFixed(2)}</p>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-bordered align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Producto</th>
                                            <th>Presentación</th>
                                            <th class="text-end">Cantidad</th>
                                            <th class="text-end">Precio Unit.</th>
                                            <th class="text-end">Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${filas}
                                    </tbody>
                                </table>
                            </div>
                        `;
                    })
                    .catch(() => {
                        contenedor.innerHTML = `
                            <div class="alert alert-danger">
                                Error al cargar el detalle de la venta.
                            </div>
                        `;
                    });
            }

            document.getElementById('formAnularVenta').addEventListener('submit', function (e) {
                e.preventDefault();

                const idVenta = document.getElementById('idVentaAnular').value;

                cerrarModal('modalConfirmarAnulacion');

                fetch('?handler=Anular', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('#formAnularVenta input[name="__RequestVerificationToken"]').value,
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: new URLSearchParams({
                        idVenta: idVenta
                    })
                })
                    .then(r => r.json())
                    .then(data => {
                        if (!data.success) {
                            mostrarResultadoError(data.message || 'No se pudo anular la venta.');
                            return;
                        }

                        mostrarProcesandoAnulacion();
                        actualizarFilaVenta(idVenta, 'ANULACION_PENDIENTE');
                        consultarEstadoAnulacion(idVenta, 0);
                    })
                    .catch(() => {
                        mostrarResultadoError('Error al anular la venta.');
                    });
            });

            function consultarEstadoAnulacion(idVenta, intento) {
                const maxIntentos = 18;

                setTimeout(() => {
                    fetch(`?handler=ObtenerDetalleVenta&idVenta=${idVenta}`)
                        .then(r => r.json())
                        .then(data => {
                            if (!data.success) {
                                if (intento >= maxIntentos) {
                                    mostrarAnulacionPendiente();
                                    return;
                                }

                                consultarEstadoAnulacion(idVenta, intento + 1);
                                return;
                            }

                            const estado = data.venta.estado;

                            actualizarFilaVenta(idVenta, estado);

                            if (estado === 'ANULADA') {
                                cerrarModal('modalProcesandoAnulacion');
                                mostrarResultadoExito('La venta fue anulada correctamente.');
                                return;
                            }

                            if (estado === 'CONFIRMADA') {
                                if (intento >= maxIntentos) {
                                    mostrarAnulacionPendiente();
                                    return;
                                }

                                consultarEstadoAnulacion(idVenta, intento + 1);
                                return;
                            }

                            if (estado === 'ANULACION_PENDIENTE') {
                                if (intento >= maxIntentos) {
                                    mostrarAnulacionPendiente();
                                    return;
                                }

                                consultarEstadoAnulacion(idVenta, intento + 1);
                                return;
                            }

                            if (intento >= maxIntentos) {
                                mostrarAnulacionPendiente();
                                return;
                            }

                            consultarEstadoAnulacion(idVenta, intento + 1);
                        })
                        .catch(() => {
                            if (intento >= maxIntentos) {
                                mostrarAnulacionPendiente();
                                return;
                            }

                            consultarEstadoAnulacion(idVenta, intento + 1);
                        });
                }, 500);
            }

            function mostrarProcesandoAnulacion() {
                document.getElementById('spinnerProcesandoAnulacion').style.display = 'inline-block';
                document.getElementById('textoProcesandoAnulacion').textContent =
                    'Estamos anulando la venta. Espere un momento...';

                document.getElementById('footerProcesandoAnulacion').style.display = 'none';

                const modal = new bootstrap.Modal(document.getElementById('modalProcesandoAnulacion'));
                modal.show();
            }

            function mostrarAnulacionPendiente() {
                document.getElementById('spinnerProcesandoAnulacion').style.display = 'none';
                document.getElementById('textoProcesandoAnulacion').textContent =
                    'La anulación está pendiente. Puede actualizar la lista en unos momentos.';

                document.getElementById('footerProcesandoAnulacion').style.display = 'flex';
            }

            function mostrarResultadoExito(mensaje) {
                document.getElementById('textoResultadoAnulacion').textContent = mensaje;

                const modal = new bootstrap.Modal(document.getElementById('modalResultadoAnulacion'));
                modal.show();
            }

            function mostrarResultadoError(mensaje) {
                document.getElementById('textoProcesandoAnulacion').textContent = mensaje;
                document.getElementById('spinnerProcesandoAnulacion').style.display = 'none';
                document.getElementById('footerProcesandoAnulacion').style.display = 'flex';

                const modal = new bootstrap.Modal(document.getElementById('modalProcesandoAnulacion'));
                modal.show();
            }

            function cerrarModal(idModal) {
                const elemento = document.getElementById(idModal);
                const instancia = bootstrap.Modal.getInstance(elemento);

                if (instancia) {
                    instancia.hide();
                }
            }

            document.getElementById('btnVerComprobanteDetalle').addEventListener('click', function () {
                const idVenta = this.dataset.idVenta;

                if (!idVenta) {
                    return;
                }

                window.open(`?handler=VerComprobante&idVenta=${idVenta}`, '_blank');
            });

            reconectarEventosBotones();
        });
    </script>
}
