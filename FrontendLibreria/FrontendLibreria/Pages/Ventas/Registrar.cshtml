@page
@model FrontendLibreria.Pages.Ventas.RegistrarModel

@{
    ViewData["Title"] = "Registrar Venta";
}

<div class="ventas-page">
    <div class="content-area">
        <div class="ventas-card">
            <h2 class="ventas-titulo">REGISTRO DE VENTA</h2>

            <div class="card p-4 shadow-sm mb-4">
                <form method="post" id="ventaForm">
                    @Html.AntiForgeryToken()

                    <div class="row g-3 align-items-center bg-light p-3 rounded border">
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Fecha:</label>
                            <input type="text" class="form-control" value="@DateTime.Now.ToString("dd/MM/yyyy")" disabled>
                        </div>

                        <div class="col-md-4 position-relative">
                            <label for="ciCliente" class="form-label fw-bold">
                                CI Cliente: <span class="text-danger">*</span>
                            </label>

                            <div class="input-group">
                                <input type="text" id="ciCliente" class="form-control" placeholder="Buscar por CI">
                                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalNuevoCliente">
                                    Nuevo
                                </button>
                            </div>

                            <div id="ciDropdown" class="dropdown-menu w-100" style="display:none; max-height:220px; overflow-y:auto;"></div>

                            <input type="hidden" id="idCliente">
                            <input type="hidden" id="clienteRazonSocial">
                            <input type="hidden" id="clienteCi">
                            <input type="hidden" id="clienteComplemento">
                            <input type="hidden" id="clienteEmail">
                            <input type="hidden" id="clienteFrecuente">

                            <div id="clienteFeedback" class="form-text"></div>
                        </div>

                        <div class="col-md-5">
                            <label for="nombreCliente" class="form-label fw-bold">Cliente:</label>
                            <input type="text" id="nombreCliente" class="form-control" disabled>
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="row g-3 align-items-end">
                        <div class="col-md-6 position-relative">
                            <label for="nombreProducto" class="form-label fw-bold">
                                Producto: <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="nombreProducto" class="form-control" placeholder="Buscar producto o presentación">
                            <div id="productoDropdown" class="dropdown-menu w-100" style="display:none; max-height:240px; overflow-y:auto;"></div>
                        </div>

                        <div class="col-md-2">
                            <label for="cantidadProducto" class="form-label fw-bold">Cantidad:</label>
                            <input type="text" id="cantidadProducto" class="form-control" value="1" inputmode="numeric" autocomplete="off">
                        </div>

                        <div class="col-md-2">
                            <label for="precioProducto" class="form-label fw-bold">Precio:</label>
                            <input type="text" id="precioProducto" class="form-control" disabled>
                        </div>

                        <div class="col-md-2">
                            <button type="button" id="btnAgregarProducto" class="btn btn-success w-100">
                                Agregar
                            </button>
                        </div>
                    </div>

                    <div id="productoFeedback" class="form-text text-danger mt-2"></div>

                    <div class="table-responsive mt-4">
                        <table class="table table-bordered align-middle" id="tablaProductos">
                            <thead class="table-light">
                                <tr>
                                    <th>Producto</th>
                                    <th>Presentación</th>
                                    <th class="text-end">Cantidad</th>
                                    <th class="text-end">Precio Unit.</th>
                                    <th class="text-end">Subtotal</th>
                                    <th class="text-center">Acción</th>
                                </tr>
                            </thead>

                            <tbody></tbody>

                            <tfoot>
                                <tr>
                                    <th colspan="4" class="text-end">Total:</th>
                                    <th class="text-end"><span id="totalVenta">0.00</span> Bs.</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="text-end mt-3">
                        <button type="submit" class="btn btn-primary">
                            Registrar Venta
                        </button>
                    </div>
                </form>

                <div class="modal fade" id="modalNuevoCliente" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title">Nuevo cliente</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>

                            <div class="modal-body">
                                <form id="formNuevoCliente">
                                    <div class="mb-3">
                                        <label class="form-label">Razón social</label>
                                        <input type="text" id="modalRazonSocial" class="form-control">
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">CI</label>
                                        <input type="text" id="modalCi" class="form-control">
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Complemento</label>
                                        <input type="text" id="modalComplemento" class="form-control">
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Email</label>
                                        <input type="email" id="modalEmail" class="form-control">
                                    </div>

                                    <div class="form-check mb-3">
                                        <input type="checkbox" id="modalFrecuente" class="form-check-input">
                                        <label class="form-check-label" for="modalFrecuente">
                                            Cliente frecuente
                                        </label>
                                    </div>

                                    <div id="modalFeedback" class="text-danger"></div>
                                </form>
                            </div>

                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                    Cancelar
                                </button>

                                <button type="button" class="btn btn-primary" id="btnGuardarClienteModal">
                                    Guardar cliente
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal fade" id="modalConfirmarVenta" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-primary">
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title">Confirmar venta</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>

                            <div class="modal-body text-center">
                                <p class="mb-2">¿Está seguro de registrar esta venta?</p>
                                <h5>Total: <strong id="lblTotalConfirmar">0.00 Bs.</strong></h5>
                            </div>

                            <div class="modal-footer justify-content-center">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                    Cancelar
                                </button>

                                <button type="button" class="btn btn-success" id="btnConfirmarVentaReal">
                                    Sí, registrar venta
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal fade" id="modalProcesandoVenta" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-primary">
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title">Procesando venta</h5>
                            </div>

                            <div class="modal-body text-center">
                                <div id="spinnerProcesandoVenta" class="spinner-border text-primary mb-3" role="status">
                                    <span class="visually-hidden">Procesando...</span>
                                </div>

                                <p id="textoProcesandoVenta" class="mb-0">
                                    Estamos confirmando la venta. Espere un momento...
                                </p>
                            </div>

                            <div class="modal-footer justify-content-center" id="footerProcesandoVenta" style="display:none;">
                                <button type="button" class="btn btn-secondary" id="btnRegistrarOtraDesdeProceso">
                                    Registrar otra venta
                                </button>

                                <a href="/Ventas/IndexVentas" class="btn btn-primary">
                                    Ver lista de ventas
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal fade" id="modalVentaExitosa" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-success">
                            <div class="modal-header bg-success text-white">
                                <h5 class="modal-title">Venta confirmada</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>

                            <div class="modal-body text-center">
                                <p id="textoVentaExitosa" class="mb-0">
                                    La venta fue confirmada correctamente.
                                </p>
                            </div>

                            <div class="modal-footer justify-content-center">
                                <button type="button" class="btn btn-secondary" id="btnRegistrarOtraVenta">
                                    Registrar otra venta
                                </button>

                                <button type="button" class="btn btn-primary" id="btnImprimirComprobante" data-id-venta="">
                                    Imprimir comprobante
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal fade" id="modalVentaError" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-danger">
                            <div class="modal-header bg-danger text-white">
                                <h5 class="modal-title">Venta no completada</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>

                            <div class="modal-body text-center">
                                <p id="textoVentaError"></p>
                            </div>

                            <div class="modal-footer justify-content-center">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                    Cerrar
                                </button>

                                <button type="button" class="btn btn-primary" id="btnRegistrarOtraDesdeError">
                                    Registrar otra venta
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let productoTemporal = null;

        document.addEventListener('DOMContentLoaded', function () {
            const ciInput = document.getElementById('ciCliente');
            const ciDropdown = document.getElementById('ciDropdown');
            const nombreClienteInput = document.getElementById('nombreCliente');
            const clienteFeedback = document.getElementById('clienteFeedback');

            const productoInput = document.getElementById('nombreProducto');
            const productoDropdown = document.getElementById('productoDropdown');
            const cantidadInput = document.getElementById('cantidadProducto');
            const precioInput = document.getElementById('precioProducto');
            const productoFeedback = document.getElementById('productoFeedback');

            function seleccionarCliente(cliente) {
                document.getElementById('idCliente').value = cliente.id ?? '';
                document.getElementById('clienteRazonSocial').value = cliente.razonSocial ?? '';
                document.getElementById('clienteCi').value = cliente.ci ?? '';
                document.getElementById('clienteComplemento').value = cliente.complemento ?? '';
                document.getElementById('clienteEmail').value = cliente.email ?? '';
                document.getElementById('clienteFrecuente').value = cliente.clienteFrecuente ? 'true' : 'false';

                ciInput.value = cliente.ciCompleto ?? cliente.ci ?? '';
                nombreClienteInput.value = cliente.razonSocial ?? '';

                ciInput.classList.remove('is-invalid');
                ciInput.classList.add('is-valid');

                clienteFeedback.textContent = 'Cliente seleccionado.';
                clienteFeedback.className = 'form-text text-success';

                ciDropdown.style.display = 'none';
            }

            ciInput.addEventListener('input', function () {
                const ci = this.value.trim();

                nombreClienteInput.value = '';

                document.getElementById('idCliente').value = '';
                document.getElementById('clienteRazonSocial').value = '';
                document.getElementById('clienteCi').value = '';
                document.getElementById('clienteComplemento').value = '';
                document.getElementById('clienteEmail').value = '';
                document.getElementById('clienteFrecuente').value = '';

                ciInput.classList.remove('is-valid', 'is-invalid');
                clienteFeedback.textContent = '';

                if (ci.length < 2) {
                    ciDropdown.style.display = 'none';
                    return;
                }

                fetch(`?handler=BuscarClientesParcial&ci=${encodeURIComponent(ci)}`)
                    .then(r => r.json())
                    .then(data => {
                        ciDropdown.innerHTML = '';

                        if (!data.success || !data.clientes || data.clientes.length === 0) {
                            ciDropdown.style.display = 'none';
                            return;
                        }

                        data.clientes.forEach(c => {
                            const item = document.createElement('button');
                            item.type = 'button';
                            item.className = 'dropdown-item';
                            item.textContent = `${c.ciCompleto ?? c.ci} - ${c.razonSocial}`;

                            item.addEventListener('click', () => seleccionarCliente(c));

                            ciDropdown.appendChild(item);
                        });

                        ciDropdown.style.display = 'block';
                    })
                    .catch(() => {
                        ciDropdown.style.display = 'none';
                    });
            });

            document.getElementById('btnGuardarClienteModal').addEventListener('click', function () {
                const cliente = {
                    razonSocial: document.getElementById('modalRazonSocial').value.trim(),
                    ci: document.getElementById('modalCi').value.trim(),
                    complemento: document.getElementById('modalComplemento').value.trim() || null,
                    email: document.getElementById('modalEmail').value.trim() || null,
                    clienteFrecuente: document.getElementById('modalFrecuente').checked
                };

                const modalFeedback = document.getElementById('modalFeedback');

                if (!cliente.razonSocial || !cliente.ci) {
                    modalFeedback.textContent = 'La razón social y el CI son obligatorios.';
                    return;
                }

                fetch('?handler=CrearCliente', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(cliente)
                })
                    .then(r => r.json())
                    .then(data => {
                        if (!data.success) {
                            modalFeedback.textContent = data.message || 'No se pudo crear el cliente.';
                            return;
                        }

                        seleccionarCliente(data.cliente);

                        const modal = bootstrap.Modal.getInstance(document.getElementById('modalNuevoCliente'));
                        modal.hide();

                        document.getElementById('formNuevoCliente').reset();
                        modalFeedback.textContent = '';
                    })
                    .catch(() => {
                        modalFeedback.textContent = 'Error al crear cliente.';
                    });
            });

            productoInput.addEventListener('input', function () {
                const termino = this.value.trim();

                productoTemporal = null;
                precioInput.value = '';
                productoFeedback.textContent = '';

                if (termino.length < 2) {
                    productoDropdown.style.display = 'none';
                    return;
                }

                fetch(`?handler=BuscarNombre&termino=${encodeURIComponent(termino)}`)
                    .then(r => r.json())
                    .then(data => {
                        productoDropdown.innerHTML = '';

                        if (!data || data.length === 0) {
                            productoDropdown.style.display = 'none';
                            return;
                        }

                        data.forEach(p => {
                            const item = document.createElement('button');
                            item.type = 'button';
                            item.className = 'dropdown-item';

                            const precio = Number(p.precio || 0);

                            item.textContent = `${p.texto} - Bs ${precio.toFixed(2)}`;

                            item.addEventListener('click', () => {
                                productoTemporal = {
                                    idProducto: p.idProducto,
                                    idPresentacion: p.idPresentacion,
                                    producto: p.producto,
                                    presentacion: p.presentacion,
                                    texto: p.texto
                                };

                                productoInput.value = p.texto;
                                precioInput.value = precio.toFixed(2);
                                productoDropdown.style.display = 'none';
                            });

                            productoDropdown.appendChild(item);
                        });

                        productoDropdown.style.display = 'block';
                    })
                    .catch(() => {
                        productoDropdown.style.display = 'none';
                    });
            });

            document.addEventListener('click', e => {
                if (!e.target.closest('.position-relative')) {
                    ciDropdown.style.display = 'none';
                    productoDropdown.style.display = 'none';
                }
            });

            document.getElementById('btnAgregarProducto').addEventListener('click', function () {
                if (!productoTemporal) {
                    productoFeedback.textContent = 'Debe seleccionar un producto de la lista.';
                    return;
                }

                const cantidad = parseInt(cantidadInput.value.trim());

                if (isNaN(cantidad) || cantidad <= 0) {
                    productoFeedback.textContent = 'La cantidad debe ser mayor a cero.';
                    return;
                }

                fetch(`?handler=ObtenerDetalleProducto&frase=${encodeURIComponent(productoInput.value)}&idProducto=${productoTemporal.idProducto}&idPresentacion=${productoTemporal.idPresentacion}`)
                    .then(r => r.json())
                    .then(data => {
                        if (!data.success) {
                            productoFeedback.textContent = data.message || 'No se pudo obtener el producto.';
                            return;
                        }

                        agregarProductoATabla(data.producto, cantidad);

                        productoTemporal = null;
                        productoInput.value = '';
                        precioInput.value = '';
                        cantidadInput.value = '1';
                        productoFeedback.textContent = '';
                    })
                    .catch(() => {
                        productoFeedback.textContent = 'Error al obtener el producto.';
                    });
            });

            function agregarProductoATabla(producto, cantidad) {
                const tbody = document.querySelector('#tablaProductos tbody');

                const precioUnitario = Number(producto.precioUnitario);
                const subtotal = cantidad * precioUnitario;

                const nombreProducto = producto.nombreProducto ?? producto.nombre ?? '';
                const nombrePresentacion = producto.nombrePresentacion ?? 'Unidad';

                const fila = document.createElement('tr');

                fila.dataset.idProducto = producto.idProducto;
                fila.dataset.idPresentacion = producto.idPresentacion;
                fila.dataset.nombreProducto = nombreProducto;
                fila.dataset.nombrePresentacion = nombrePresentacion;
                fila.dataset.precio = precioUnitario;

                fila.innerHTML = `
                    <td>${nombreProducto}</td>
                    <td>${nombrePresentacion}</td>
                    <td class="text-end">
                        <input type="text"
                               class="form-control form-control-sm text-end cantidad-detalle"
                               value="${cantidad}"
                               inputmode="numeric"
                               autocomplete="off">
                    </td>
                    <td class="text-end">${precioUnitario.toFixed(2)}</td>
                    <td class="text-end subtotal">${subtotal.toFixed(2)}</td>
                    <td class="text-center">
                        <button type="button" class="btn btn-danger btn-sm btnEliminarProducto">
                            Quitar
                        </button>
                    </td>
                `;

                fila.querySelector('.cantidad-detalle').addEventListener('input', function () {
                    const valor = this.value.trim();

                    if (valor === '') {
                        fila.querySelector('.subtotal').textContent = '0.00';
                        actualizarTotal();
                        return;
                    }

                    const nuevaCantidad = parseInt(valor);

                    if (isNaN(nuevaCantidad) || nuevaCantidad <= 0) {
                        fila.querySelector('.subtotal').textContent = '0.00';
                        actualizarTotal();
                        return;
                    }

                    const nuevoSubtotal = nuevaCantidad * precioUnitario;
                    fila.querySelector('.subtotal').textContent = nuevoSubtotal.toFixed(2);

                    actualizarTotal();
                });

                fila.querySelector('.btnEliminarProducto').addEventListener('click', function () {
                    fila.remove();
                    actualizarTotal();
                });

                tbody.appendChild(fila);
                actualizarTotal();
            }

            function actualizarTotal() {
                let total = 0;

                document.querySelectorAll('#tablaProductos tbody tr').forEach(fila => {
                    const subtotal = parseFloat(fila.querySelector('.subtotal').textContent);
                    total += isNaN(subtotal) ? 0 : subtotal;
                });

                document.getElementById('totalVenta').textContent = total.toFixed(2);
            }

            document.getElementById('ventaForm').addEventListener('submit', function (e) {
                e.preventDefault();

                const idCliente = document.getElementById('idCliente').value;

                if (!idCliente) {
                    clienteFeedback.textContent = 'Debe seleccionar un cliente válido.';
                    clienteFeedback.className = 'form-text text-danger fw-bold';
                    ciInput.classList.add('is-invalid');
                    return;
                }

                const filas = document.querySelectorAll('#tablaProductos tbody tr');

                if (filas.length === 0) {
                    document.getElementById('textoVentaError').textContent =
                        'Debe agregar al menos un producto a la venta antes de registrarla.';

                    const modalError = new bootstrap.Modal(document.getElementById('modalVentaError'));
                    modalError.show();
                    return;
                }

                document.getElementById('lblTotalConfirmar').textContent =
                    document.getElementById('totalVenta').textContent + ' Bs.';

                const modalConfirmar = new bootstrap.Modal(document.getElementById('modalConfirmarVenta'));
                modalConfirmar.show();
            });

            document.getElementById('btnConfirmarVentaReal').addEventListener('click', function () {
                const filas = document.querySelectorAll('#tablaProductos tbody tr');
                const detalles = [];

                let cantidadInvalida = false;

                filas.forEach(fila => {
                    const cantidad = parseInt(fila.querySelector('.cantidad-detalle').value.trim());

                    if (isNaN(cantidad) || cantidad <= 0) {
                        cantidadInvalida = true;
                        return;
                    }

                    const precioUnitario = parseFloat(fila.dataset.precio);

                    detalles.push({
                        idProducto: parseInt(fila.dataset.idProducto),
                        idPresentacion: parseInt(fila.dataset.idPresentacion),
                        nombreProducto: fila.dataset.nombreProducto,
                        nombrePresentacion: fila.dataset.nombrePresentacion,
                        cantidad: cantidad,
                        precioUnitario: precioUnitario,
                        subtotal: cantidad * precioUnitario
                    });
                });

                if (cantidadInvalida) {
                    cerrarModal('modalConfirmarVenta');
                    mostrarError('Todas las cantidades deben ser mayores a cero.');
                    return;
                }

                const payload = {
                    idCliente: parseInt(document.getElementById('idCliente').value),
                    razonSocial: document.getElementById('clienteRazonSocial').value,
                    ci: document.getElementById('clienteCi').value,
                    complemento: document.getElementById('clienteComplemento').value || null,
                    email: document.getElementById('clienteEmail').value || null,
                    clienteFrecuente: document.getElementById('clienteFrecuente').value === 'true',
                    detalles: detalles
                };

                fetch('?handler=RegistrarVenta', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(payload)
                })
                    .then(r => r.json())
                    .then(data => {
                        cerrarModal('modalConfirmarVenta');

                        if (!data.success) {
                            mostrarError(data.message || 'No se pudo registrar la venta.');
                            return;
                        }

                        mostrarProcesandoVenta();
                        consultarEstadoVenta(data.idVenta, 0);
                    })
                    .catch(() => {
                        cerrarModal('modalConfirmarVenta');
                        mostrarError('Error al registrar la venta.');
                    });
            });

            function consultarEstadoVenta(idVenta, intento) {
                const maxIntentos = 18;

                setTimeout(() => {
                    fetch(`?handler=EstadoVenta&idVenta=${idVenta}`)
                        .then(r => r.json())
                        .then(data => {
                            if (!data.success) {
                                if (intento >= maxIntentos) {
                                    mostrarPendiente();
                                    return;
                                }

                                consultarEstadoVenta(idVenta, intento + 1);
                                return;
                            }

                            if (data.confirmada) {
                                cerrarModal('modalProcesandoVenta');
                                mostrarVentaConfirmada(idVenta);
                                return;
                            }

                            if (data.noCompletada) {
                                cerrarModal('modalProcesandoVenta');
                                mostrarError('La venta no pudo completarse por disponibilidad insuficiente de productos.');
                                return;
                            }

                            if (data.anulada) {
                                cerrarModal('modalProcesandoVenta');
                                mostrarError('La venta fue anulada.');
                                return;
                            }

                            if (intento >= maxIntentos) {
                                mostrarPendiente();
                                return;
                            }

                            consultarEstadoVenta(idVenta, intento + 1);
                        })
                        .catch(() => {
                            if (intento >= maxIntentos) {
                                mostrarPendiente();
                                return;
                            }

                            consultarEstadoVenta(idVenta, intento + 1);
                        });
                }, 500);
            }

            function mostrarProcesandoVenta() {
                document.getElementById('spinnerProcesandoVenta').style.display = 'inline-block';
                document.getElementById('textoProcesandoVenta').textContent =
                    'Estamos confirmando la venta. Espere un momento...';

                document.getElementById('footerProcesandoVenta').style.display = 'none';

                const modal = new bootstrap.Modal(document.getElementById('modalProcesandoVenta'));
                modal.show();
            }

            function mostrarPendiente() {
                document.getElementById('spinnerProcesandoVenta').style.display = 'none';
                document.getElementById('textoProcesandoVenta').textContent =
                    'La venta fue registrada y está pendiente de confirmación. Puede revisar su estado en la lista de ventas.';

                document.getElementById('footerProcesandoVenta').style.display = 'flex';
            }

            function mostrarVentaConfirmada(idVenta) {
                document.getElementById('textoVentaExitosa').textContent =
                    'La venta fue confirmada correctamente.';

                document.getElementById('btnImprimirComprobante').dataset.idVenta = idVenta;

                const modalExito = new bootstrap.Modal(document.getElementById('modalVentaExitosa'));
                modalExito.show();
            }

            function mostrarError(mensaje) {
                document.getElementById('textoVentaError').textContent = mensaje;

                const modalError = new bootstrap.Modal(document.getElementById('modalVentaError'));
                modalError.show();
            }

            function cerrarModal(idModal) {
                const elemento = document.getElementById(idModal);
                const instancia = bootstrap.Modal.getInstance(elemento);

                if (instancia) {
                    instancia.hide();
                }
            }

            document.getElementById('btnRegistrarOtraVenta').addEventListener('click', function () {
                window.location.reload();
            });

            document.getElementById('btnRegistrarOtraDesdeProceso').addEventListener('click', function () {
                window.location.reload();
            });

            document.getElementById('btnRegistrarOtraDesdeError').addEventListener('click', function () {
                window.location.reload();
            });

            document.getElementById('btnImprimirComprobante').addEventListener('click', function () {
                const idVenta = this.dataset.idVenta;

                if (!idVenta)
                    return;

                window.open(`?handler=ImprimirComprobante&idVenta=${idVenta}`, '_blank');
            });
        });
    </script>
}