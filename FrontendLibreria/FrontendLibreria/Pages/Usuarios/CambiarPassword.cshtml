@page
@model FrontendLibreria.Pages.Usuarios.CambiarPasswordModel
@{
    ViewData["Title"] = "Cambiar Contraseña";
    bool esForzado = ViewData["Forzado"] as bool? ?? false;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-lg">
                <div class="card-header bg-primary text-white text-center py-4">
                    <h3 class="mb-0">Seguridad de la Cuenta</h3>
                </div>
                <div class="card-body p-4">
                    
                    @if (esForzado)
                    {
                        <div class="alert alert-warning d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2" style="font-size: 1.5rem;"></i>
                            <div>
                                <strong>¡Atención!</strong> @ViewData["MensajeForzado"]
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger">@Model.ErrorMessage</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                    {
                        <div class="alert alert-success">@Model.SuccessMessage</div>
                        
                        @if (ViewData["Redirect"] as bool? == true)
                        {
                            <script>
                                setTimeout(function () {
                                    window.location.href = '/Usuarios/Login';
                                }, 3000);
                            </script>
                        }
                    }

                    <form method="post" id="formPassword">
                        <div class="mb-3">
                            <label asp-for="Input.PasswordActual" class="form-label fw-bold">Contraseña Actual</label>
                            <input asp-for="Input.PasswordActual" type="password" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.NuevoPassword" class="form-label fw-bold">Nueva Contraseña</label>
                            <input asp-for="Input.NuevoPassword" type="password" class="form-control" id="nuevoPassword" required />
                        </div>
                        <div class="mb-4">
                            <label asp-for="Input.ConfirmarPassword" class="form-label fw-bold">Confirmar Nueva Contraseña</label>
                            <input asp-for="Input.ConfirmarPassword" type="password" class="form-control" id="confirmarPassword" required />
                            <div id="matchError" class="text-danger small mt-1" style="display:none;">Las contraseñas no coinciden.</div>
                        </div>

                        <!-- Políticas de Seguridad Visuales -->
                        <div class="p-3 bg-light rounded border mb-4">
                            <h6 class="fw-bold mb-2">La contraseña debe contener:</h6>
                            <ul class="list-unstyled mb-0" id="passwordPolicies">
                                <li id="pol-length" class="text-danger"><i class="bi bi-x-circle me-2"></i>Mínimo 8 caracteres</li>
                                <li id="pol-upper" class="text-danger"><i class="bi bi-x-circle me-2"></i>Al menos 1 mayúscula</li>
                                <li id="pol-lower" class="text-danger"><i class="bi bi-x-circle me-2"></i>Al menos 1 minúscula</li>
                                <li id="pol-number" class="text-danger"><i class="bi bi-x-circle me-2"></i>Al menos 1 número</li>
                                <li id="pol-special" class="text-danger"><i class="bi bi-x-circle me-2"></i>Al menos 1 carácter especial</li>
                            </ul>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg" id="btnSubmit" disabled>Actualizar Contraseña</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Incluir Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const inputPass = document.getElementById("nuevoPassword");
        const inputConfirm = document.getElementById("confirmarPassword");
        const btnSubmit = document.getElementById("btnSubmit");
        const matchError = document.getElementById("matchError");

        const rules = {
            length: val => val.length >= 8,
            upper: val => /[A-Z]/.test(val),
            lower: val => /[a-z]/.test(val),
            number: val => /[0-9]/.test(val),
            special: val => /[!@@#\$%\^\&*\)\(+=._-]/.test(val)
        };

        function updatePolicy(id, isValid) {
            const el = document.getElementById(id);
            const icon = el.querySelector("i");
            if (isValid) {
                el.classList.remove("text-danger");
                el.classList.add("text-success");
                icon.classList.remove("bi-x-circle");
                icon.classList.add("bi-check-circle-fill");
            } else {
                el.classList.remove("text-success");
                el.classList.add("text-danger");
                icon.classList.remove("bi-check-circle-fill");
                icon.classList.add("bi-x-circle");
            }
        }

        function validatePassword() {
            const val = inputPass.value;
            const validLength = rules.length(val);
            const validUpper = rules.upper(val);
            const validLower = rules.lower(val);
            const validNumber = rules.number(val);
            const validSpecial = rules.special(val);

            updatePolicy("pol-length", validLength);
            updatePolicy("pol-upper", validUpper);
            updatePolicy("pol-lower", validLower);
            updatePolicy("pol-number", validNumber);
            updatePolicy("pol-special", validSpecial);

            const allValid = validLength && validUpper && validLower && validNumber && validSpecial;
            
            const match = val === inputConfirm.value && inputConfirm.value !== "";
            if (inputConfirm.value !== "") {
                matchError.style.display = match ? "none" : "block";
            } else {
                matchError.style.display = "none";
            }

            btnSubmit.disabled = !(allValid && match);
        }

        inputPass.addEventListener("input", validatePassword);
        inputConfirm.addEventListener("input", validatePassword);
    });
</script>
