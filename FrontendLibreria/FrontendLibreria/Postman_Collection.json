    {
      "name": "2. Auth - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('jwt_token', jsonData.token);",
              "    console.log('✅ Token guardado: ' + jsonData.token.substring(0, 20) + '...');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombreUsuario\": \"admin.prueba\",\n  \"password\": \"temporal123\"\n}"
        },
        "url": {
          "raw": "https://localhost:7064/api/Auth/login",
          "protocol": "https",
          "host": ["localhost"],
          "port": "7064",
          "path": ["api", "Auth", "login"]
        },
        "description": "Obtiene el JWT token. Se guarda automáticamente en {{jwt_token}}"
      },
      "response": []
    },
